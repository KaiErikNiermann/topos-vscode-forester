out
dist
node_modules
.vscode-test/
*.vsix
test-forest/
*.tree
# ...except the shared grammar corpus, whose whole purpose is to be run in CI
# against both parsers (see tests/corpus/README.md). The blanket rule above
# had been keeping that directory empty, so test:corpus asserted nothing.
!tests/corpus/*.tree
.serena/
# Stray IDE-generated transpilation output alongside .ts sources in workspace
# packages — only the esbuild bundles under their dist/ folders are real outputs.
graph-view/src/*.js
graph-view/src/*.js.map
forester-graph/src/*.js
forester-graph/src/*.js.map
# Claude local state (sessions, conversation history, etc.)
.claude/projects/
.claude/*.local.json
# Track project-level hook scripts and settings
!.claude/hooks/
!.claude/settings.json
.forester-formatter.json
# LanguageTool runtime cache (binary, regenerated locally)
.languagecheck.db
