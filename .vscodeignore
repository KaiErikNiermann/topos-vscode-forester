# Workspace package sources/tooling — only their built bundles ship.
graph-view/src/**
graph-view/esbuild.config.mjs
graph-view/node_modules/**
forester-graph/src/**
forester-graph/esbuild.config.mjs
forester-graph/node_modules/**
