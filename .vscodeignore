# `dist/graph-view/` is intentionally NOT excluded — the .vsix ships it so
# that `forester.exportGraphView` can copy its files into a user-chosen
# folder without requiring the source repo or pnpm.
!dist/graph-view/**

# Repo/dev cruft that has no business in a published .vsix. The marketplace
# README pulls its screenshots from raw.githubusercontent.com absolute URLs,
# so demo/ ships nothing the listing needs.
.remember/**
.claude/**
.husky/**
.github/**
.languagecheck.db
