{
  "scopeName": "source.forester",
  "patterns": [
    {
      "include": "#body"
    }
  ],
  "repository": {
    "body": {
      "patterns": [
        {
          "include": "#raw-group"
        },
        {
          "include": "#tex-command"
        },
        {
          "include": "#tex"
        },
        {
          "include": "#verbatim-block"
        },
        {
          "include": "#verbatim-inline"
        },
        {
          "include": "#link"
        },
        {
          "begin": "(\\\\transclude|\\\\import|\\\\export|\\\\ref)\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "contentName": "markup.underline.link.forester",
          "beginCaptures": {
            "1": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "begin": "(\\\\em)\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "contentName": "markup.italic.forester",
          "beginCaptures": {
            "1": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "begin": "(\\\\strong)\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "contentName": "markup.bold.forester",
          "beginCaptures": {
            "1": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "begin": "(\\\\title)\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "contentName": "markup.heading.forester",
          "beginCaptures": {
            "1": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "begin": "(\\\\code)\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#body"
            }
          ],
          "contentName": "markup.inline.raw.forester",
          "beginCaptures": {
            "1": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "include": "#math"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#command"
        },
        {
          "include": "#sig-comment"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "math-body": {
      "comment": "Body of #{ … } / ##{ … }. Forester lexes math with a rule of its own (`math` in lib/parser/Lexer.mll) that emits no square, paren or '!{' tokens, so the constructs those characters spell elsewhere cannot form here: '[[…]]' is a link only because the parser sees one square group nested in another (Expand.ml), and with no square tokens there are no such groups — a bracket matrix is TeX. '!' is a factorial rather than a raw-group herald. Hence #link and #raw-group are absent from this list; everything else the math rule does recognise — commands, comments, verbatim, nested math, braces — stays.",
      "patterns": [
        {
          "include": "#tex-command"
        },
        {
          "include": "#tex"
        },
        {
          "include": "#verbatim-block"
        },
        {
          "include": "#verbatim-inline"
        },
        {
          "include": "#math"
        },
        {
          "include": "#math-braces"
        },
        {
          "include": "#command"
        },
        {
          "include": "#sig-comment"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "math": {
      "begin": "#?#\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#math-body"
        }
      ],
      "contentName": "meta.math.forester"
    },
    "braces": {
      "comment": "A { … } group in ordinary body text. Recursing rather than skipping to the next '}' is what keeps an enclosing block — the math rule above, most of all — from being closed by a brace that belongs to something nested inside it.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#text"
        },
        {
          "include": "#body"
        }
      ]
    },
    "math-braces": {
      "comment": "As #braces, but staying inside math: a group nested in a formula is still a formula, so \\mathcal{[[x]]} must not find a link either.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#text"
        },
        {
          "include": "#math-body"
        }
      ]
    },
    "text": {
      "patterns": [
        {
          "match": "([^%#\\\\\\{\\}\\[\\]\\(\\)\\r\\n]|\\\\%|\\\\\\\\)+",
          "name": "markup.text.forester"
        }
      ]
    },
    "tex": {
      "comment": "\\startverb%tex block with LaTeX highlighting",
      "begin": "(\\\\startverb)(%)(tex).*",
      "end": "\\\\stopverb",
      "patterns": [
        {
          "include": "text.tex.latex"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "constant.language.forester"
        },
        "2": {
          "name": "punctuation.definition.comment.forester comment.line.percentage.forester"
        },
        "3": {
          "name": "keyword.other.forester"
        }
      },
      "endCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      },
      "contentName": "embedded.latex"
    },
    "tex-command": {
      "comment": "\\tex{preamble}{content} - handles both arguments",
      "begin": "(\\\\tex)\\s*(\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "constant.language.forester"
        },
        "2": {
          "name": "punctuation.definition.group.begin.forester"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.group.end.forester"
        }
      },
      "patterns": [
        {
          "include": "#tex-preamble-content"
        }
      ]
    },
    "tex-preamble-content": {
      "comment": "Content inside \\tex first arg (preamble) with LaTeX highlighting",
      "patterns": [
        {
          "include": "#tex-nested-brace-latex"
        },
        {
          "include": "text.tex.latex"
        },
        {
          "include": "#tex-second-arg"
        }
      ]
    },
    "tex-second-arg": {
      "comment": "Second argument of \\tex - content with possible verbatim",
      "begin": "(\\})\\s*(\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.group.end.forester"
        },
        "2": {
          "name": "punctuation.definition.group.begin.forester"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.group.end.forester"
        }
      },
      "patterns": [
        {
          "include": "#tex-verbatim-block"
        },
        {
          "include": "#tex-nested-brace-content"
        },
        {
          "include": "text.tex.latex"
        }
      ],
      "contentName": "meta.embedded.block.latex"
    },
    "tex-nested-brace-latex": {
      "comment": "Nested braces in LaTeX preamble",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#tex-nested-brace-latex"
        },
        {
          "include": "text.tex.latex"
        }
      ]
    },
    "tex-verbatim-block": {
      "comment": "Verbatim block inside \\tex content - no LaTeX highlighting",
      "begin": "\\\\startverb",
      "end": "\\\\stopverb",
      "contentName": "markup.raw.forester",
      "beginCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      },
      "endCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      }
    },
    "tex-nested-brace-content": {
      "comment": "Nested braces in tex content that may contain verbatim",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#tex-verbatim-block"
        },
        {
          "include": "#tex-nested-brace-content"
        },
        {
          "include": "text.tex.latex"
        }
      ]
    },
    "verbatim-block": {
      "comment": "Block verbatim: \\startverb is the last thing on its line, content spans following lines until \\stopverb. Used by \\codeblock{lang}{\\startverb … \\stopverb}.",
      "begin": "\\\\startverb(?=\\s*$)",
      "end": "\\\\stopverb",
      "contentName": "markup.raw.forester",
      "beginCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      },
      "endCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      }
    },
    "verbatim-inline": {
      "comment": "Inline verbatim: \\startverb is followed by content on the same line, e.g. \\code{\\startverb\\taxon{x}\\stopverb}. Ends at \\stopverb OR end of line, so an unterminated verbatim cannot bleed its raw scope across the rest of the document.",
      "begin": "\\\\startverb(?!\\s*$)",
      "end": "\\\\stopverb|$",
      "contentName": "markup.raw.forester",
      "beginCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      },
      "endCaptures": {
        "0": {
          "name": "constant.language.forester"
        }
      }
    },
    "command": {
      "patterns": [
        {
          "match": "\\\\[A-Za-z][0-9A-Za-z\\-/#]*",
          "captures": {
            "0": {
              "name": "constant.language.forester"
            }
          }
        },
        {
          "match": "\\\\<([A-Za-z][0-9A-Za-z\\-/#:]*)>",
          "captures": {
            "0": {
              "name": "constant.language.forester"
            },
            "1": {
              "name": "support.variable.xmlns.forester"
            }
          }
        }
      ]
    },
    "sig-comment": {
      "comment": "JSDoc-style highlighting for `%! sig` macro-signature comments: the in-comment tokens (command, param names, kinds, dynamic @sources) get colored scopes so they stand out from ordinary `%` comments.",
      "begin": "(%!)\\s*(sig)\\b",
      "end": "$\\n?",
      "name": "comment.line.documentation.sig.forester",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.forester"
        },
        "2": {
          "name": "keyword.control.directive.sig.forester"
        }
      },
      "patterns": [
        {
          "match": "\\\\[A-Za-z]\\w*",
          "name": "entity.name.function.sig.forester"
        },
        {
          "match": "@[A-Za-z][\\w-]*",
          "name": "support.type.sig.forester"
        },
        {
          "match": "\\b(flags|number|content|opaque)\\b",
          "name": "storage.type.sig.forester"
        },
        {
          "match": "([A-Za-z_]\\w*)\\s*(\\?)?(?=\\s*:)",
          "captures": {
            "1": {
              "name": "variable.parameter.sig.forester"
            },
            "2": {
              "name": "keyword.operator.optional.sig.forester"
            }
          }
        },
        {
          "match": "\\|",
          "name": "keyword.operator.sig.forester"
        }
      ]
    },
    "comment": {
      "begin": "%",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.forester"
        }
      },
      "end": "$\\n?",
      "name": "comment.line.percentage.forester"
    },
    "link": {
      "patterns": [
        {
          "match": "\\[([^\\[]*)\\]\\(([^\\)]*)\\)",
          "captures": {
            "1": {
              "name": "markup.text.forester"
            },
            "2": {
              "name": "markup.underline.link.forester"
            }
          }
        },
        {
          "begin": "\\[\\[",
          "end": "\\]\\]",
          "contentName": "markup.underline.link.forester"
        }
      ]
    },
    "raw-group": {
      "comment": "!{ … } raw group. Forester lexes the body verbatim, so it is foreign syntax — in practice LaTeX, which is what it is highlighted as. Braces must balance (that is how the group ends), so the recursive nested-brace rule keeps the outermost } as the terminator.",
      "begin": "(!)(\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.forester"
        },
        "2": {
          "name": "punctuation.definition.group.begin.forester"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.group.end.forester"
        }
      },
      "contentName": "embedded.latex",
      "patterns": [
        {
          "include": "#tex-nested-brace-latex"
        },
        {
          "include": "text.tex.latex"
        }
      ]
    }
  }
}
